              "type": "run_python",
              "code": "import os\nimport re\n\ndownloads_folder = r\"C:\\Users\\ndsouza\\Downloads\"\nbase_name = \"Accrual Details - Negative Balance\"\n\npattern = re.compile(\n    r\"^Accrual Details - Negative Balance(?: \\((\\d+)\\))?\\.csv$\",\n    re.IGNORECASE\n)\n\nbest_file = None\nhighest_number = -1\n\nfor filename in os.listdir(downloads_folder):\n    match = pattern.match(filename)\n\n    if match:\n        if match.group(1):\n            file_number = int(match.group(1))\n        else:\n            file_number = 0\n\n        if file_number > highest_number:\n            highest_number = file_number\n            best_file = os.path.join(downloads_folder, filename)\n\nif best_file is None:\n    raise Exception(\n        \"No matching Accrual Details - Negative Balance CSV file was found.\"\n    )\n\nprint(\"Opening: \" + best_file)\n\n# Opens the CSV using its default Windows application, normally Excel.\nos.startfile(best_file)"
            }
