        "Combine Dated Export Files": {
          "events": [
            {
              "dt": 0.1,
              "type": "run_python",
              "code": "from pathlib import Path\nfrom datetime import date\nimport pandas as pd\n\n# -----------------------------\n# Settings\n# -----------------------------\nFOLDER_PATH = Path(r\"C:\\Users\\ndsouza\\Downloads\\Pay Period Close\")\nYEAR = 2026\nMONTH = 10  # October\n\nOUTPUT_FILE_NAME = \"Combined_Output.xlsx\"\n\n\ndef read_csv_with_fallback(file_path):\n    \"\"\"Read a CSV while handling common file encodings.\"\"\"\n    encodings = [\"utf-8-sig\", \"utf-8\", \"cp1252\", \"latin1\"]\n\n    for encoding in encodings:\n        try:\n            return pd.read_csv(\n                file_path,\n                skiprows=8,  # Remove rows 1-8; row 9 becomes the header\n                encoding=encoding\n            )\n        except UnicodeDecodeError:\n            continue\n\n    raise ValueError(f\"Unable to determine encoding for: {file_path.name}\")\n\n\ndef combine_csv_files(folder_path):\n    combined_data = []\n\n    for file_path in folder_path.glob(\"*.csv\"):\n        # Expected filename examples: 9.csv, 10.csv, 31.csv\n        try:\n            day = int(file_path.stem)\n            file_date = date(YEAR, MONTH, day)\n        except ValueError:\n            print(\n                f\"Skipped '{file_path.name}': \"\n                \"the filename must be a day number, such as 9.csv.\"\n            )\n            continue\n\n        try:\n            df = read_csv_with_fallback(file_path)\n\n            # Remove fully blank rows and columns\n            df = df.dropna(how=\"all\")\n            df = df.dropna(axis=1, how=\"all\")\n\n            if df.empty:\n                print(f\"Skipped '{file_path.name}': no table data was found.\")\n                continue\n\n            # Clean extra spaces from column names\n            df.columns = [str(column).strip() for column in df.columns]\n\n            # Add Date as the first column\n            df.insert(0, \"Date\", pd.Timestamp(file_date))\n\n            combined_data.append(df)\n            print(f\"Added: {file_path.name} ({len(df):,} rows)\")\n\n        except Exception as error:\n            print(f\"Error processing '{file_path.name}': {error}\")\n\n    if not combined_data:\n        print(\"No valid CSV files were found.\")\n        return\n\n    combined_df = pd.concat(combined_data, ignore_index=True)\n\n    # Sort by Date if desired\n    combined_df = combined_df.sort_values(\"Date\").reset_index(drop=True)\n\n    output_path = folder_path / OUTPUT_FILE_NAME\n\n    with pd.ExcelWriter(\n        output_path,\n        engine=\"openpyxl\",\n        datetime_format=\"mmm d, yyyy\"\n    ) as writer:\n        combined_df.to_excel(\n            writer,\n            sheet_name=\"Combined Data\",\n            index=False\n        )\n\n        worksheet = writer.sheets[\"Combined Data\"]\n\n        # Freeze the header row\n        worksheet.freeze_panes = \"A2\"\n\n        # Enable filters\n        worksheet.auto_filter.ref = worksheet.dimensions\n\n        # Format the Date column\n        for cell in worksheet[\"A\"][1:]:\n            cell.number_format = \"mmm d, yyyy\"\n\n        # Adjust column widths\n        for column_cells in worksheet.columns:\n            values = [\n                str(cell.value) for cell in column_cells\n                if cell.value is not None\n            ]\n            max_length = max((len(value) for value in values), default=10)\n            worksheet.column_dimensions[\n                column_cells[0].column_letter\n            ].width = min(max_length + 2, 50)\n\n    print(f\"\\nFinished! Combined file saved to:\\n{output_path}\")\n\n\nif __name__ == \"__main__\":\n    combine_csv_files(FOLDER_PATH)"
            }
          ],
          "hotkey": "None",
          "mouse": "None",
          "speed": 1.0,
          "loops": 1
        }
      },
